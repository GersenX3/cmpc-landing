# Credenciales temporales del panel admin (mock, mientras no exista backend PHP/MySQL).
# Copia este archivo como ".env" (que ya está en .gitignore) y define tus propios valores.
# ¡IMPORTANTE! Esto es solo un candado temporal del lado del cliente — cualquiera que
# inspeccione el bundle de JS puede verlo. NO usar así en producción real; reemplazar
# por login contra el backend en cuanto exista (ver src/services/authService.ts).
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=cambiame
